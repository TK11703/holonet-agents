    "version": "0.2.0",
    "configurations": [
        {
            "name": "C#: HolonetAgents.Web (https)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/src/HolonetAgents.Web/bin/Debug/net10.0/HolonetAgents.Web.dll",
            "cwd": "${workspaceFolder}/src/HolonetAgents.Web",
            "launchSettingsFilePath": "${workspaceFolder}/src/HolonetAgents.Web/Properties/launchSettings.json",
            "launchSettingsProfile": "https",
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
            },
            "console": "internalConsole",
            "stopAtEntry": false
        },
        {
            "name": "C#: HolonetAgents.Web (http)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/src/HolonetAgents.Web/bin/Debug/net10.0/HolonetAgents.Web.dll",
            "cwd": "${workspaceFolder}/src/HolonetAgents.Web",
            "launchSettingsFilePath": "${workspaceFolder}/src/HolonetAgents.Web/Properties/launchSettings.json",
            "launchSettingsProfile": "http",
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
            },
            "console": "internalConsole",
            "stopAtEntry": false
        }
    ]
}